generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenancy ────────────────────────────────────────────────────────────
// Cada "org" es un estudio jurídico independiente.
// Todos los modelos tienen orgId → los datos nunca se mezclan entre estudios.

model Organizacion {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique // ej: "estudio-garcia"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios    Usuario[]
  clientes    Cliente[]
  causas      Causa[]
  eventos     Evento[]
  honorarios  Honorario[]
  documentos  Documento[]

  @@map("organizaciones")
}

// ─── Usuarios / Auth ──────────────────────────────────────────────────────────

enum Rol {
  TITULAR
  ASOCIADO
  ADMINISTRATIVO
  CLIENTE
}

model Usuario {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  nombreCompleto String
  rol          Rol      @default(ADMINISTRATIVO)
  telefono     String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgId String
  org   Organizacion @relation(fields: [orgId], references: [id], onDelete: Cascade)

  causasAsignadas Causa[]
  eventosCreados  Evento[]
  documentosSubidos Documento[]

  @@unique([email, orgId])
  @@map("usuarios")
}

// ─── Clientes ─────────────────────────────────────────────────────────────────

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  apellido  String
  dni       String?
  email     String?
  telefono  String?
  direccion String?
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organizacion @relation(fields: [orgId], references: [id], onDelete: Cascade)

  causas     Causa[]
  honorarios Honorario[]
  documentos Documento[]

  @@map("clientes")
}

// ─── Causas / Expedientes ─────────────────────────────────────────────────────

enum EstadoCausa {
  ACTIVA
  SUSPENDIDA
  ARCHIVADA
  RESUELTA
}

model Causa {
  id               String      @id @default(cuid())
  numeroExpediente String
  caratula         String
  fuero            String?
  juzgado          String?
  estado           EstadoCausa @default(ACTIVA)
  descripcion      String?
  fechaInicio      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  orgId String
  org   Organizacion @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  abogadoId String?
  abogado   Usuario? @relation(fields: [abogadoId], references: [id], onDelete: SetNull)

  eventos    Evento[]
  honorarios Honorario[]
  documentos Documento[]

  @@unique([numeroExpediente, orgId])
  @@map("causas")
}

// ─── Agenda / Eventos ─────────────────────────────────────────────────────────

enum TipoEvento {
  AUDIENCIA
  VENCIMIENTO
  REUNION
  OTRO
}

model Evento {
  id                  String     @id @default(cuid())
  titulo              String
  descripcion         String?
  tipo                TipoEvento @default(OTRO)
  fechaHora           DateTime
  recordatorioEnviado Boolean    @default(false)
  createdAt           DateTime   @default(now())

  orgId String
  org   Organizacion @relation(fields: [orgId], references: [id], onDelete: Cascade)

  causaId String?
  causa   Causa?  @relation(fields: [causaId], references: [id], onDelete: SetNull)

  creadoPorId String?
  creadoPor   Usuario? @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@map("eventos")
}

// ─── Honorarios ───────────────────────────────────────────────────────────────

enum EstadoHonorario {
  PENDIENTE
  PARCIAL
  CANCELADO
}

model Honorario {
  id           String          @id @default(cuid())
  concepto     String
  montoTotal   Decimal         @db.Decimal(12, 2)
  montoPagado  Decimal         @default(0) @db.Decimal(12, 2)
  estado       EstadoHonorario @default(PENDIENTE)
  fechaAcuerdo DateTime?
  notas        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  orgId String
  org   Organizacion @relation(fields: [orgId], references: [id], onDelete: Cascade)

  causaId String?
  causa   Causa?  @relation(fields: [causaId], references: [id], onDelete: SetNull)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@map("honorarios")
}

// ─── Documentos ───────────────────────────────────────────────────────────────

model Documento {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  storagePath String   // ruta local o URL en S3/R2
  mimeType    String?
  sizeBytes   BigInt?
  createdAt   DateTime @default(now())

  orgId String
  org   Organizacion @relation(fields: [orgId], references: [id], onDelete: Cascade)

  causaId String?
  causa   Causa?  @relation(fields: [causaId], references: [id], onDelete: SetNull)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  subidoPorId String?
  subidoPor   Usuario? @relation(fields: [subidoPorId], references: [id], onDelete: SetNull)

  @@map("documentos")
}
